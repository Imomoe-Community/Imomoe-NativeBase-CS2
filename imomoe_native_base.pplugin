{
  "$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/tags/v3.1.0/schemas/plugin.schema.json",
  "version": "0.4.0",
  "name": "imomoe_native_base",
  "description": "Shared Source 2 engine bridges for Imomoe plugins",
  "author": "Mai Ooizumi",
  "website": "https://github.com/Imomoe-Community/Imomoe-NativeBase-CS2",
  "license": "AGPL-3.0-or-later",
  "entry": "bin/imomoe-native-base",
  "platforms": [],
  "language": "cpp",
  "dependencies": [
    {
      "name": "s2sdk",
      "constraints": "3.5.1"
    },
    {
      "name": "polyhook",
      "constraints": ">=2.5.7"
    }
  ],
  "methods": [
    {
      "name": "ForceRespawnClient",
      "funcName": "ForceRespawnClient",
      "group": "Clients",
      "description": "On the game thread, performs a full engine respawn for the slot, including a live player. Does nothing if the player pawn cannot be safely owned by the controller.",
      "paramTypes": [
        { "name": "playerSlot", "type": "int32", "ref": false }
      ],
      "retType": { "type": "void" }
    },
    {
      "name": "SnapPlayerViewAngles",
      "funcName": "SnapPlayerViewAngles",
      "group": "Clients",
      "description": "On the game thread, sends the native view-angle change to one complete player pawn handle. True means the native call was issued, not that the client has displayed it.",
      "paramTypes": [
        { "name": "pawnHandle", "type": "int32", "ref": false },
        { "name": "viewAngles", "type": "vec3", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "SetNativeWeaponCommandCallback",
      "group": "Weapons",
      "description": "Registers one game-thread callback at the end of native player command simulation, while the matching controller command remains installed.",
      "funcName": "SetNativeWeaponCommandCallback",
      "paramTypes": [
        {
          "name": "enabled",
          "type": "bool"
        },
        {
          "name": "callback",
          "type": "function",
          "prototype": "NativeWeaponCommandCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasNativeWeaponShotSupport",
      "group": "Weapons",
      "description": "Whether the shared native stock-weapon firing path is available.",
      "funcName": "HasNativeWeaponShotSupport",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "FireNativeWeaponShot",
      "group": "Weapons",
      "description": "Issues one native shot from a live player using a stock hitscan weapon profile without equipping it. Only valid within that pawn's native weapon command callback. True means the temporary source spent a cartridge.",
      "funcName": "FireNativeWeaponShot",
      "paramTypes": [
        {
          "name": "shooterPawn",
          "type": "int32",
          "ref": false,
          "description": "Complete handle of the live firing pawn."
        },
        {
          "name": "weaponDefinition",
          "type": "uint16",
          "ref": false,
          "description": "Stock economy item definition selected by the caller."
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "GetClientUserID",
      "group": "Clients",
      "description": "Returns the current engine userid, or -1 for a disconnected or invalid slot.",
      "funcName": "GetClientUserID",
      "paramTypes": [
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "HasNativeRoundScoreSupport",
      "funcName": "HasNativeRoundScoreSupport",
      "group": "RoundScore",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "FinishNativeTeamRound",
      "funcName": "FinishNativeTeamRound",
      "group": "RoundScore",
      "description": "Records one T (2) or CT (3) win in the native score state and ends the live round.",
      "paramTypes": [
        { "name": "team", "type": "int32" },
        { "name": "restartDelay", "type": "float" }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "HasTargetAttackSupport",
      "funcName": "HasTargetAttackSupport",
      "group": "TargetAttack",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "SetTargetAttackCallback",
      "funcName": "SetTargetAttackCallback",
      "group": "TargetAttack",
      "paramTypes": [
        { "name": "enabled", "type": "bool", "ref": false },
        { "name": "callback", "type": "function", "prototype": "TargetAttackCallback", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "HasChronoAttackSupport",
      "funcName": "HasChronoAttackSupport",
      "group": "Chrono",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "SetChronoAttackCallback",
      "funcName": "SetChronoAttackCallback",
      "group": "Chrono",
      "paramTypes": [
        { "name": "enabled", "type": "bool", "ref": false },
        { "name": "callback", "type": "function", "prototype": "ChronoAttackCallback", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "HasRecoilImpulseSupport",
      "funcName": "HasRecoilImpulseSupport",
      "group": "RecoilImpulse",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "SetRecoilImpulseCallback",
      "funcName": "SetRecoilImpulseCallback",
      "group": "RecoilImpulse",
      "paramTypes": [
        { "name": "enabled", "type": "bool", "ref": false },
        { "name": "callback", "type": "function", "prototype": "RecoilImpulseFactor", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "HasC4DefuseAccessSupport",
      "funcName": "HasC4DefuseAccessSupport",
      "group": "C4Access",
      "description": "Resolves the native C4 factory, selector and defuse-start admission sites.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasC4PlantBlockSupport",
      "funcName": "HasC4PlantBlockSupport",
      "group": "C4Access",
      "description": "Resolves the common native C4 plant entry used by USE and attack.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "SetC4DefuseAccess",
      "funcName": "SetC4DefuseAccess",
      "group": "C4Access",
      "description": "Enables or restores game-thread C4 defuse admission by the team at plant time.",
      "paramTypes": [
        {
          "name": "enabled",
          "type": "bool"
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "SetC4PlantBlocked",
      "funcName": "SetC4PlantBlocked",
      "group": "C4Access",
      "description": "Blocks or restores native C4 planting without changing C4 inventory or custom actions.",
      "paramTypes": [
        {
          "name": "blocked",
          "type": "bool"
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "CanCreateGrenadeProjectile",
      "funcName": "CanCreateGrenadeProjectile",
      "group": "Grenades",
      "description": "Checks one projectile factory: smoke (1), Molotov (2), or HE (4). The optional rain policy also requires exact inferno lineage.",
      "paramTypes": [
        {
          "name": "kind",
          "type": "int32"
        },
        {
          "name": "forceRainSelfDamage",
          "type": "bool"
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "CreateGrenadeProjectile",
      "funcName": "CreateGrenadeProjectile",
      "group": "Grenades",
      "description": "Spawns a native projectile on the game thread. Velocity is in units per second. Thrower is a complete pawn handle, or -1 for world-attributed Molotov. Rain self-damage is opt-in for pawn-attributed Molotov only. Returns a complete entity handle or -1.",
      "paramTypes": [
        {
          "name": "kind",
          "type": "int32"
        },
        {
          "name": "position",
          "type": "vec3",
          "ref": false
        },
        {
          "name": "velocity",
          "type": "vec3",
          "ref": false
        },
        {
          "name": "throwerPawn",
          "type": "int32"
        },
        {
          "name": "forceRainSelfDamage",
          "type": "bool"
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "ShouldBypassSelfDamageForRain",
      "funcName": "ShouldBypassSelfDamageForRain",
      "group": "MolotovRain",
      "description": "Returns true only for a tracked force-self rain inferno and its exact original thrower pawn.",
      "paramTypes": [
        {
          "name": "inflictor",
          "type": "int32"
        },
        {
          "name": "victimPawn",
          "type": "int32"
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "ClearMolotovRainTracking",
      "funcName": "ClearMolotovRainTracking",
      "group": "MolotovRain",
      "description": "Discards tracked rain projectile and inferno associations on the game thread.",
      "paramTypes": [],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "HasReloadSyncSupport",
      "funcName": "HasReloadSyncSupport",
      "group": "ReloadSync",
      "description": "Checks the native weapon dispatcher and required event/schema imports without activating synchronization.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasFullMagazineReloadSupport",
      "funcName": "HasFullMagazineReloadSupport",
      "group": "ReloadSync",
      "description": "Checks the native full-magazine capacity comparisons without installing hooks.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "UpdateReloadPolicy",
      "funcName": "UpdateReloadPolicy",
      "group": "ReloadSync",
      "description": "Updates reload policy on the game thread: 0 failed, 1 settled, 2 accepted native transfers still draining. Immediate OFF detaches for shutdown without waiting.",
      "paramTypes": [
        {
          "name": "synchronize",
          "type": "bool"
        },
        {
          "name": "allowFullMagazine",
          "type": "bool"
        },
        {
          "name": "immediate",
          "type": "bool"
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "HasWorldItemFactorySupport",
      "funcName": "HasWorldItemFactorySupport",
      "group": "WorldItems",
      "description": "On the game thread, resolves the native ownerless item factory, optionally with the HE ground-ammo initializer.",
      "paramTypes": [{ "name": "withGrenadeAmmo", "type": "bool" }],
      "retType": { "type": "bool" }
    },
    {
      "name": "CreateWorldItem",
      "funcName": "CreateWorldItem",
      "group": "WorldItems",
      "description": "Creates an ownerless knife, or with the ammo flag an HE with stock pickup ammo. Returns the complete handle, or -1.",
      "paramTypes": [
        { "name": "definition", "type": "uint16" },
        { "name": "position", "type": "vec3", "ref": false },
        { "name": "primeGrenadeAmmo", "type": "bool" }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "HasPlayerMovementHullSupport",
      "funcName": "HasPlayerMovementHullSupport",
      "group": "WallHang",
      "description": "On the game thread, checks the movement-trace helper, its native call site, and the loaded physics-query receiver.",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "TracePlayerMovementHull",
      "funcName": "TracePlayerMovementHull",
      "group": "WallHang",
      "description": "On the game thread, traces the supplied real local hull using the pinned player-movement filter while ignoring one exact full player-pawn handle. Returns true only after finite trace outputs are validated; a successful miss returns true with outHit=false and outEntityHandle=-1. Failure returns false with deterministic miss outputs. It never passes engine pointers across this provider boundary.",
      "paramTypes": [
        { "name": "pawnHandle", "type": "int32", "ref": false },
        { "name": "start", "type": "vec3", "ref": false },
        { "name": "end", "type": "vec3", "ref": false },
        { "name": "hullMins", "type": "vec3", "ref": false },
        { "name": "hullMaxs", "type": "vec3", "ref": false },
        { "name": "outPosition", "type": "vec3", "ref": true },
        { "name": "outFraction", "type": "float", "ref": true },
        { "name": "outHit", "type": "bool", "ref": true },
        { "name": "outEntityHandle", "type": "int32", "ref": true },
        { "name": "outStartSolid", "type": "bool", "ref": true },
        { "name": "outNormal", "type": "vec3", "ref": true }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "HasPlayerRandomSpawnPointSupport",
      "funcName": "HasPlayerRandomSpawnPointSupport",
      "group": "RandomSpawn",
      "description": "Whether the native engine spawn-point selector is available. Call on the game thread.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "SelectPlayerRandomSpawnPoint",
      "funcName": "SelectPlayerRandomSpawnPoint",
      "group": "RandomSpawn",
      "description": "Validate and select a map-defined deathmatch spawn point for an exact pawn, starting at a complete point handle. Returns a complete handle, or -1 including engine fallback to normal team starts. Does not move the player. Game thread only.",
      "paramTypes": [
        {
          "name": "pawnHandle",
          "type": "int32"
        },
        {
          "name": "startPointHandle",
          "type": "int32"
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "HasThirdPersonEyeSupport", "funcName": "HasThirdPersonEyeSupport", "group": "ThirdPerson",
      "description": "On the game thread, checks the optional pawn eye camera-branch Hook ABI and schema. Does not change any view.",
      "paramTypes": [], "retType": { "type": "bool" }
    },
    {
      "name": "RegisterThirdPersonEyeTarget", "funcName": "RegisterThirdPersonEyeTarget", "group": "ThirdPerson",
      "description": "On the game thread, registers one exact pawn/camera pair before assigning its view. Only a live own-camera path uses the original pawn eye branch.",
      "paramTypes": [{ "name": "pawn", "type": "int32", "ref": false }, { "name": "camera", "type": "int32", "ref": false }],
      "retType": { "type": "bool" }
    },
    {
      "name": "UnregisterThirdPersonEyeTarget", "funcName": "UnregisterThirdPersonEyeTarget", "group": "ThirdPerson",
      "description": "On the game thread, removes an exact pair only after its pawn view no longer references the owned camera. A failed detach remains retryable.",
      "paramTypes": [{ "name": "pawn", "type": "int32", "ref": false }, { "name": "camera", "type": "int32", "ref": false }],
      "retType": { "type": "bool" }
    },
    {
      "name": "ResetThirdPersonEyeTargets", "funcName": "ResetThirdPersonEyeTargets", "group": "ThirdPerson",
      "description": "Map transition only: drops all old-map target identities and detaches the eye Hook without resolving or modifying reused entity handles.",
      "paramTypes": [], "retType": { "type": "bool" }
    },
    {
      "name": "HasGrenadeDetonateSupport",
      "funcName": "HasGrenadeDetonateSupport",
      "group": "Grenades",
      "description": "On the game thread, checks kind 1 smoke, 2 Molotov, 3 incendiary, 4 HE, 5 flash, or 6 decoy independently and installs an owned pre-hook that claims natural Detonate entry for complete projectile handles.",
      "paramTypes": [{ "name": "kind", "type": "int32" }],
      "retType": { "type": "bool" }
    },
    {
      "name": "GetGrenadeDetonationState",
      "funcName": "GetGrenadeDetonationState",
      "group": "Grenades",
      "description": "On the game thread, checks kind 1 smoke, 2 Molotov, 3 incendiary, 4 HE, 5 flash, or 6 decoy independently. Returns 1 when any Detonate entry claimed this exact full handle or its non-sentinel projectile has disappeared, 0 for a valid matching projectile not yet claimed, and -1 when support, kind, identity, or state resolution fails. It never changes projectile physics or calls Detonate.",
      "paramTypes": [
        { "name": "projectileHandle", "type": "int32" },
        { "name": "kind", "type": "int32" }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "DetonateGrenade",
      "funcName": "DetonateGrenade",
      "group": "Grenades",
      "description": "On the game thread, requests native Detonate for an exact full handle after caller-side provenance, managed-projectile exclusion, and proximity checks. Returns 1 when submitted, 0 when natural or earlier Detonate was already claimed or the non-sentinel handle normally disappeared, and -1 on support, identity, or submission failure.",
      "paramTypes": [
        { "name": "projectileHandle", "type": "int32" },
        { "name": "kind", "type": "int32" }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "SetGrenadeDetonationHold",
      "funcName": "SetGrenadeDetonationHold",
      "group": "Grenades",
      "description": "On the game thread, holds native smoke activation, fire ignition or decoy activation for one matching full handle. Operation 1 holds, 0 releases and replays an intercepted request, and 2 discards the hold before dud removal.",
      "paramTypes": [
        { "name": "projectileHandle", "type": "int32" },
        { "name": "kind", "type": "int32" },
        { "name": "operation", "type": "int32" }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "CreateGrenadeDud",
      "funcName": "CreateGrenadeDud",
      "group": "Grenades",
      "description": "Creates the exact stock ownerless grenade item with pickup ammo, using the typed grenade kind. Returns its complete handle, or -1 if creation failed.",
      "paramTypes": [
        { "name": "kind", "type": "int32" },
        { "name": "position", "type": "vec3", "ref": false }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "TryIgnitePlayer",
      "funcName": "TryIgnitePlayer",
      "group": "Afterburn",
      "description": "On the game thread, attempts native mode-14 ignition for one exact current live player pawn without replacing a valid attached effect. Returns the new attached entityflame full handle for exact caller-owned lifecycle cleanup, or -1 when validation or readback fails.",
      "paramTypes": [
        { "name": "pawnHandle", "type": "int32", "ref": false },
        { "name": "duration", "type": "float", "ref": false }
      ],
      "retType": {
        "type": "int32",
        "description": "-1 on validation/effect verification failure; otherwise the newly attached entityflame full handle."
      }
    },
    {
      "name": "HasSuicideSupport",
      "funcName": "HasSuicideSupport",
      "group": "Suicide",
      "description": "Reports whether the optional CanAcquire hook and inspect-button schema are available.",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "GetLookAtWeaponButtonState",
      "funcName": "GetLookAtWeaponButtonState",
      "group": "Suicide",
      "description": "Returns live IN_LOOK_AT_WEAPON state for an exact pawn handle, or -1 when unavailable.",
      "paramTypes": [
        { "name": "pawnHandle", "type": "int32", "ref": false }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "HookPlayerCanAcquire",
      "funcName": "HookPlayerCanAcquire",
      "group": "Suicide",
      "description": "Hooks pickup acquisition decisions so only active suicide bombers are denied weapon pickups.",
      "paramTypes": [
        { "name": "callback", "type": "function", "prototype": "PlayerCanAcquireCallback", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "UnhookPlayerCanAcquire",
      "funcName": "UnhookPlayerCanAcquire",
      "group": "Suicide",
      "description": "Removes the optional CanAcquire detour and callback.",
      "paramTypes": [
        { "name": "callback", "type": "function", "prototype": "PlayerCanAcquireCallback", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "SupportsFirearmHeadContact",
      "funcName": "SupportsFirearmHeadContact",
      "group": "Damage",
      "description": "Reports support for the player damage callback's native firearm head contact flag.",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "HasPlayerTakeDamagePre",
      "funcName": "HasPlayerTakeDamagePre",
      "group": "Damage",
      "description": "Reports whether the current native damage-hook prerequisites are available.",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "HookPlayerTakeDamagePre",
      "funcName": "HookPlayerTakeDamagePre",
      "group": "Damage",
      "description": "Installs the exclusive synchronous player damage policy callback.",
      "paramTypes": [
        { "name": "callback", "type": "function", "prototype": "DamagePreCallback", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "UnhookPlayerTakeDamagePre",
      "funcName": "UnhookPlayerTakeDamagePre",
      "group": "Damage",
      "description": "Revokes the player damage callback and removes its detour.",
      "paramTypes": [
        { "name": "callback", "type": "function", "prototype": "DamagePreCallback", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "HasEntityTakeDamagePre",
      "funcName": "HasEntityTakeDamagePre",
      "group": "Damage",
      "description": "Reports whether the shared non-player damage callback prerequisites are available without player-only headshot tracing.",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "HookEntityTakeDamagePre",
      "funcName": "HookEntityTakeDamagePre",
      "group": "Damage",
      "description": "Subscribes one synchronous non-player entity damage callback to the shared TakeDamageOld detour; nonzero suppresses native damage.",
      "paramTypes": [
        { "name": "callback", "type": "function", "prototype": "EntityDamagePreCallback", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "UnhookEntityTakeDamagePre",
      "funcName": "UnhookEntityTakeDamagePre",
      "group": "Damage",
      "description": "Revokes this entity damage callback and removes the shared detour only when no damage callbacks remain. Returns true when this callback is absent or revoked; other callbacks are untouched.",
      "paramTypes": [
        { "name": "callback", "type": "function", "prototype": "EntityDamagePreCallback", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "GetCurrentDamageFrameToken",
      "funcName": "GetCurrentDamageFrameToken",
      "group": "Damage",
      "description": "Returns the current nested damage-call token, or zero outside a damage call.",
      "paramTypes": [],
      "retType": { "type": "uint64" }
    },
    {
      "name": "HasCurrentDirectKnifeContact",
      "funcName": "HasCurrentDirectKnifeContact",
      "group": "Damage",
      "description": "Whether the current non-synthetic damage frame contains an original knife trace contact on its player victim.",
      "paramTypes": [],
      "retType": { "type": "bool" }
    },
    {
      "name": "GetCurrentDirectFirearmContactGroup",
      "funcName": "GetCurrentDirectFirearmContactGroup",
      "group": "Damage",
      "description": "Returns the exact target hitbox group of a direct native firearm trace attached to the current damage frame, or -1 when absent.",
      "paramTypes": [],
      "retType": { "type": "int32" }
    },
    {
      "name": "GetCurrentDirectFirearmSourceBearing",
      "funcName": "GetCurrentDirectFirearmSourceBearing",
      "group": "Damage",
      "description": "Horizontal source bearing in degrees from the current authenticated native firearm ray, or NaN when absent or vertical.",
      "paramTypes": [],
      "retType": { "type": "float" }
    },
    {
      "name": "TakeEntityDamageWithWeapon",
      "funcName": "TakeEntityDamageWithWeapon",
      "group": "Damage",
      "description": "Applies native damage with an exact ability weapon handle and optional callback-specific rule bypass; returns -1 on execution failure, otherwise the actual non-negative health lost (0 is valid).",
      "paramTypes": [
        { "name": "victimHandle", "type": "int32", "ref": false },
        { "name": "inflictorHandle", "type": "int32", "ref": false },
