      "retType": { "type": "int32" }
    },
    {
      "name": "GetGameTickCount",
      "funcName": "GetGameTickCount",
      "group": "Engine",
      "description": "The standalone host fixture has a fixed game tick of zero.",
      "paramTypes": [],
      "retType": { "type": "int32" }
    },
    {
      "name": "GetGameTime",
      "funcName": "GetGameTime",
      "group": "Engine",
      "description": "The standalone host fixture has a fixed game time of zero.",
      "paramTypes": [],
      "retType": { "type": "float" }
    },
    {
      "name": "GetWeaponItemDefinition",
      "funcName": "GetWeaponItemDefinition",
      "group": "Weapons",
      "description": "Returns no item definition for the fixture's empty server.",
      "paramTypes": [
        { "name": "entityHandle", "type": "int32", "ref": false }
      ],
      "retType": { "type": "uint16" }
    },
    {
      "name": "GetEntityClassname",
      "funcName": "GetEntityClassname",
      "group": "Entities",
      "description": "Reports the fake Ignite classname and fixture standard-grenade projectile classes.",
      "paramTypes": [ { "name": "entityHandle", "type": "int32", "ref": false } ],
