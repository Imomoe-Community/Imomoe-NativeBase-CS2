      "paramTypes": [ { "name": "playerSlot", "type": "int32", "ref": false } ],
      "retType": { "type": "bool" }
    },
    {
      "name": "GetClientHealth",
      "funcName": "GetClientHealth",
      "group": "Clients",
      "description": "Returns health from the current-pawn handle during the Afterburn fixture.",
