        { "name": "className", "type": "string" },
        { "name": "memberName", "type": "string" },
        { "name": "element", "type": "int32", "ref": false }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "OnClientDisconnect_Register",
      "funcName": "OnClientDisconnect_Register",
      "group": "Listeners",
      "description": "Accepts the Rust plugin's disconnect listener in the no-client fixture.",
      "paramTypes": [
        { "name": "callback", "type": "function", "ref": false, "prototype": "OnClientDisconnectCallback" }
      ],
      "retType": { "type": "void" }
    },
    {
      "name": "OnClientDisconnect_Unregister",
      "funcName": "OnClientDisconnect_Unregister",
      "group": "Listeners",
      "description": "Accepts the Rust plugin's disconnect listener removal in the no-client fixture.",
      "paramTypes": [
        { "name": "callback", "type": "function", "ref": false, "prototype": "OnClientDisconnectCallback" }
      ],
      "retType": { "type": "void" }
    },
    {
      "name": "IsClientInGame",
      "funcName": "IsClientInGame",
