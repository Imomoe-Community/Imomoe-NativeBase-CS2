{
  "$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/v3.1.0/schemas/plugin.schema.json",
  "version": "3.4.3",
  "name": "s2sdk",
  "description": "Test-local S2SDK provider for the imomoe-native-base loader fixture",
  "author": "FunRounds native tests",
  "website": "https://github.com/Mai-Ooizumi/Imomoe-FunRounds-CS2",
  "license": "AGPL-3.0-or-later",
  "entry": "bin/s2sdk",
  "platforms": [],
  "language": "cpp",
  "dependencies": [
    { "name": "polyhook", "constraints": "=2.5.7" }
  ],
  "methods": [
    {
      "name": "HookEvent",
      "funcName": "HookEvent",
      "group": "Events",
      "description": "Accepts fixture event subscriptions without dispatching game callbacks.",
      "paramTypes": [
        { "name": "eventName", "type": "string" },
        { "name": "callback", "type": "function", "ref": false, "prototype": "EventCallback" },
        { "name": "hookMode", "type": "uint8", "ref": false }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "UnhookEvent",
      "funcName": "UnhookEvent",
      "group": "Events",
      "description": "Accepts fixture event unsubscriptions without dispatching game callbacks.",
      "paramTypes": [
        { "name": "eventName", "type": "string" },
        { "name": "callback", "type": "function", "ref": false, "prototype": "EventCallback" },
        { "name": "hookMode", "type": "uint8", "ref": false }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "PrintToServer",
      "funcName": "PrintToServer",
      "group": "Console",
      "description": "Writes fixture server messages to the host console.",
      "paramTypes": [
        { "name": "msg", "type": "string", "ref": false }
      ],
      "retType": { "type": "void" }
    },
    {
      "name": "GetSchemaOffset",
      "funcName": "GetSchemaOffset",
      "group": "Schema",
      "description": "Reports only the controller backlink needed by the no-client lifecycle probe.",
      "paramTypes": [
        { "name": "className", "type": "string" },
        { "name": "memberName", "type": "string" }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "AddConsoleCommand",
      "funcName": "AddConsoleCommand",
      "group": "Commands",
      "description": "Accepts fixture commands without dispatching them.",
      "paramTypes": [
        { "name": "name", "type": "string" },
        { "name": "description", "type": "string" },
        { "name": "flags", "type": "int64", "ref": false },
        { "name": "callback", "type": "function", "ref": false, "prototype": "ConCommandCallback" },
        { "name": "hookMode", "type": "uint8", "ref": false }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "RemoveCommand",
      "funcName": "RemoveCommand",
      "group": "Commands",
      "description": "Accepts fixture command removal during plugin shutdown.",
      "paramTypes": [
        { "name": "name", "type": "string" },
        { "name": "callback", "type": "function", "ref": false, "prototype": "ConCommandCallback" }
      ],
      "retType": { "type": "bool" }
    },
    {
      "name": "HasConsoleCommandCallbacks",
      "funcName": "HasConsoleCommandCallbacks",
      "group": "Commands",
      "description": "Reports no retained fixture command callbacks.",
      "paramTypes": [ { "name": "name", "type": "string" } ],
      "retType": { "type": "bool" }
    },
    {
      "name": "FindConVar",
      "funcName": "FindConVar",
      "group": "ConVars",
      "description": "Reports every real engine ConVar as unavailable in the fixture.",
      "paramTypes": [ { "name": "name", "type": "string" } ],
      "retType": { "type": "uint64" }
    },
    {
      "name": "UserMessageFindMessageIdByName",
      "funcName": "UserMessageFindMessageIdByName",
      "group": "UserMessages",
      "description": "Reports no real game user messages in this fixture.",
      "paramTypes": [ { "name": "messageName", "type": "string" } ],
      "retType": { "type": "int16" }
    },
    {
      "name": "QueryInterface",
      "funcName": "QueryInterface",
      "group": "Engine",
      "description": "Returns the fixture schema-system interface.",
      "paramTypes": [
        { "name": "module", "type": "string" },
        { "name": "name", "type": "string" }
      ],
      "retType": { "type": "ptr64" }
    },
    {
      "name": "LoadGameConfigFile",
      "funcName": "LoadGameConfigFile",
      "group": "Gameconfig",
      "description": "Accepts the native module's fixture gamedata path.",
      "paramTypes": [
        { "name": "paths", "type": "string[]", "ref": false }
      ],
      "retType": { "type": "uint32", "alias": { "name": "ConfigId" } }
    },
    {
      "name": "CloseGameConfigFile",
      "funcName": "CloseGameConfigFile",
      "group": "Gameconfig",
      "description": "Records native gamedata cleanup.",
      "paramTypes": [
        { "name": "id", "type": "uint32", "ref": false, "alias": { "name": "ConfigId" } }
      ],
      "retType": { "type": "void" }
    },
    {
      "name": "GetGameConfigOffset",
      "funcName": "GetGameConfigOffset",
      "group": "Gameconfig",
      "description": "Returns fixture Touch, IsWeapon, collision-notification, and grenade Detonate vtable slots.",
      "paramTypes": [
        { "name": "id", "type": "uint32", "ref": false, "alias": { "name": "ConfigId" } },
        { "name": "name", "type": "string" }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "GetGameConfigSignature",
      "funcName": "GetGameConfigSignature",
      "group": "Gameconfig",
      "description": "Returns fixture TakeDamage and damage-constructor targets.",
      "paramTypes": [
        { "name": "id", "type": "uint32", "ref": false, "alias": { "name": "ConfigId" } },
        { "name": "name", "type": "string" }
      ],
      "retType": { "type": "ptr64" }
    },
    {
      "name": "GetGameConfigVTable",
      "funcName": "GetGameConfigVTable",
      "group": "Gameconfig",
      "description": "Returns the fixture nav-physics and standard-grenade vtables.",
      "paramTypes": [
        { "name": "id", "type": "uint32", "ref": false },
        { "name": "name", "type": "string" }
      ],
      "retType": { "type": "ptr64" }
    },
    {
      "name": "EntPointerToEntHandle",
      "funcName": "EntPointerToEntHandle",
      "group": "Entities",
      "description": "Maps the fixture entity to its stable handle.",
      "paramTypes": [
        { "name": "entity", "type": "ptr64", "ref": false }
      ],
      "retType": { "type": "int32" }
    },
    {
      "name": "EntHandleToEntPointer",
      "funcName": "EntHandleToEntPointer",
      "group": "Entities",
      "description": "Returns the fixture entity for its stable handle.",
      "paramTypes": [
        { "name": "entityHandle", "type": "int32", "ref": false }
      ],
      "retType": { "type": "ptr64" }
    },
    {
      "name": "GetMaxClients",
      "funcName": "GetMaxClients",
      "group": "Engine",
      "description": "Provides the single client slot used by the Afterburn contract fixture.",
