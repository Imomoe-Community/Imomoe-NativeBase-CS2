root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
max_line_length = 150
trim_trailing_whitespace = true

[*.md]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.patch]
trim_trailing_whitespace = false

[scripts/native-live-fixture/drive-suicide.ps1]
charset = utf-8-bom
